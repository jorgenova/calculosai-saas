# Banco administrativo: Prisma, migrations e manutencao do ambiente local.
DATABASE_URL=postgresql://postgres:postgres_test_only@127.0.0.1:5433/calculosai_test

# Banco da aplicacao: role sem BYPASSRLS, equivalente ao acesso de producao.
DATABASE_URL_APP=postgresql://app_user:app_test_only@127.0.0.1:5433/calculosai_test

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=local-test-jwt-secret-with-at-least-32-characters
NODE_ENV=test
EXTERNAL_SERVICES_MODE=mock
MOCK_EXPOSE_INVITE_TOKEN=false

# Placeholders locais. No modo mock nenhuma requisicao e enviada a esses servicos.
UPSTASH_REDIS_REST_URL=https://example.invalid
UPSTASH_REDIS_REST_TOKEN=local-test-only
RESEND_API_KEY=re_local_test_only
STRIPE_SECRET_KEY=sk_test_local_only
STRIPE_PUBLIC_KEY=pk_test_local_only
STRIPE_WEBHOOK_SECRET=whsec_local_test_only
