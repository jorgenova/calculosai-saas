generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String?      @unique
  status               TenantStatus @default(pending_payment)
  stripeCustomerId     String?      @map("stripe_customer_id")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  createdAt            DateTime     @default(now()) @map("created_at")

  users       User[]
  invitations Invitation[]
  offices     Office[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  password  String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  officeAccesses OfficeAccess[]

  @@unique([email, tenantId])
  @@unique([id, tenantId])
  @@map("users")
}

model Invitation {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  email              String
  tokenHash          String        @unique @map("token_hash")
  status             InvitationStatus @default(pending)
  invitedByUserId    String        @map("invited_by_user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  expiresAt          DateTime      @map("expires_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  offices            InvitationOffice[]

  @@unique([id, tenantId])
  @@map("invitations")
}

model Office {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  cnpj      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  accesses    OfficeAccess[]
  invitations InvitationOffice[]
  companies   Company[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("offices")
}

model OfficeAccess {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  officeId  String   @map("office_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId])
  office Office @relation(fields: [officeId, tenantId], references: [id, tenantId])

  @@unique([userId, officeId])
  @@index([tenantId, userId, officeId])
  @@map("office_accesses")
}

model InvitationOffice {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  invitationId String @map("invitation_id")
  officeId     String @map("office_id")

  invitation Invitation @relation(fields: [invitationId, tenantId], references: [id, tenantId])
  office     Office     @relation(fields: [officeId, tenantId], references: [id, tenantId])

  @@unique([invitationId, officeId])
  @@index([tenantId, invitationId])
  @@map("invitation_offices")
}

model Company {
  id                    String             @id @default(uuid())
  tenantId              String             @map("tenant_id")
  officeId              String             @map("office_id")
  identificationType    IdentificationType @map("identification_type")
  taxId                 String             @map("tax_id")
  name                  String
  status                CompanyStatus      @default(active)
  requestedByUserId     String?            @map("requested_by_user_id")
  requestedAt           DateTime?          @map("requested_at")
  decidedByUserId       String?            @map("decided_by_user_id")
  decidedAt             DateTime?          @map("decided_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  office     Office             @relation(fields: [officeId, tenantId], references: [id, tenantId])
  taxPeriods CompanyTaxPeriod[]

  @@unique([officeId, identificationType, taxId])
  @@unique([id, tenantId, officeId])
  @@index([tenantId, officeId, status])
  @@map("companies")
}

model CompanyTaxPeriod {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  officeId  String    @map("office_id")
  companyId String    @map("company_id")
  taxRegime TaxRegime @map("tax_regime")
  startDate DateTime  @db.Date @map("start_date")
  endDate   DateTime? @db.Date @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId, tenantId, officeId], references: [id, tenantId, officeId])

  @@index([tenantId, officeId, companyId])
  @@map("company_tax_periods")
}

enum Role {
  owner
  attendant

  @@map("role")
}

enum TenantStatus {
  pending_payment
  active
  expired

  @@map("tenant_status")
}

enum InvitationStatus {
  pending
  accepted
  expired

  @@map("invitation_status")
}

enum IdentificationType {
  cpf
  cnpj

  @@map("identification_type")
}

enum CompanyStatus {
  active
  closure_pending
  closed

  @@map("company_status")
}

enum TaxRegime {
  mei
  simples_nacional
  lucro_presumido
  lucro_real

  @@map("tax_regime")
}
